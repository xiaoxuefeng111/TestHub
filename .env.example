# Tongdaxin Testing Platform local development environment template
#
# Windows / PowerShell:
#   Copy-Item .env.example .env
#
# This template is optimized for the minimum local development path:
#   SQLite + Django + Vite
#
# For local startup, you usually only need to confirm:
#   SECRET_KEY / DEBUG / USE_SQLITE / CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS

# ================================
# Core Django settings
# ================================
SECRET_KEY=change-me-for-local-dev
DEBUG=True
USE_SQLITE=True
ALLOWED_HOSTS=127.0.0.1,localhost
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai

# ================================
# Local frontend / backend origins
# ================================
# Vite dev server defaults to http://127.0.0.1:3000
# Django local server is expected at http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# Local HTTP defaults
APP_USE_HTTPS=False
TRUST_PROXY_SSL_HEADER=False
CSRF_USE_SESSIONS=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# ================================
# Development auth (reserved)
# ================================
# Reserved for the explicit local development JWT bootstrap.
# Contract target: POST /api/auth/dev-login/
#
# Keep BOTH flags disabled by default.
# Backend explicit switch: DEV_LOGIN_ENABLED
# Frontend explicit switch: VITE_LOCAL_DEV_AUTH
# Only enable them together on a trusted local machine.
# After changing any VITE_ variable, restart the Vite dev server.
DEV_LOGIN_ENABLED=False
VITE_LOCAL_DEV_AUTH=false

# Optional future extension if the implementation introduces a fixed dev user:
# DEV_LOGIN_USERNAME=admin

# ================================
# Optional MySQL settings
# ================================
# Only used when USE_SQLITE=False.
DB_NAME=tongdaxin_test_platform
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ================================
# Optional analytics switches
# ================================
ANALYTICS_ENABLED=False
ANALYTICS_MAX_BATCH_SIZE=20
REGISTRATION_STATS_ENABLED=False
REGISTRATION_STATS_VISIBLE_USERNAMES=
VITE_ANALYTICS_ENABLED=false

# ================================
# Optional Redis / Celery / Channels
# ================================
# Not required for the minimum local runbook.
REDIS_URL=redis://127.0.0.1:6379/0

# ================================
# Optional SMS settings
# ================================
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_REGISTER_TEMPLATE_CODE=

# ================================
# Optional email settings
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
